# Ignore everything by default
*

# Allow specific extensions only
!*.ipynb
!*.py
!*.md
!*.txt
!/python2026/9.dataframe/成绩单_示例.csv

# Allow directories to be traversed (but not their non-matching files)
!*/

# Re-ignore specific junk even if extension matches
**/__pycache__/**
**/.ipynb_checkpoints/**
**/.statamcp/**
**/stata-mcp-folder/**
**/.git/**
**/node_modules/**

# Embedded git repos (cause nested repo errors)
python1/
python2/

# Student submissions (privacy: real names + student IDs)
python2026/课堂测试1/

# Temp scripts and compare files in courseware dir
python2026/check_submission.py
ch2_compare.txt

!/README.md
!/.gitignore
