# Ignore everything by default
*

# Allow specific extensions only
!*.ipynb
!*.py
!*.md
!*.txt
!/python2026/9.dataframe/成绩单_示例.csv

# Allow directories to be traversed (but not their non-matching files)
!*/

# Re-ignore specific junk even if extension matches
**/__pycache__/**
**/.ipynb_checkpoints/**
**/.statamcp/**
**/stata-mcp-folder/**
**/.git/**
**/node_modules/**

!/README.md
!/.gitignore
